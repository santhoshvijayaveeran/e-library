    book_cards = []
    for i, book in enumerate(books):
        book_cards.append({
            'obj': book,
            'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)],
        })

    categories = []
    category_qs = (
        Category.objects.filter(books__isnull=False)
        .distinct()
        .order_by('name')
    )
    for cat in category_qs:
        icon, css_class = CATEGORY_STYLES.get(cat.name.strip().lower(), DEFAULT_CATEGORY_STYLE)
        categories.append({
            'name': cat.name,
            'icon': icon,
            'css_class': css_class,
            'image_url': cat.image.url if cat.image else None,
        })

    free_books_qs = Book.objects.filter(is_paid=False).order_by('-created_at')[:24]
    free_book_cards = []
    for i, book in enumerate(free_books_qs):
        free_book_cards.append({
            'obj': book,
            'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)],
        })

    paid_books_qs = Book.objects.filter(is_paid=True).order_by('-created_at')[:24]
    paid_book_cards = []
    for i, book in enumerate(paid_books_qs):
        paid_book_cards.append({
            'obj': book,
            'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)],
        })

    recent_books_qs = Book.objects.all().order_by('-created_at')[:24]
    recent_book_cards = []
    for i, book in enumerate(recent_books_qs):
        recent_book_cards.append({
            'obj': book,
            'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)],
        })

    popular_books_qs = (
        Book.objects.annotate(avg_rating=Avg('reviews__rating'))
        .order_by('-avg_rating')[:24]
    )
    popular_book_cards = []
    for i, book in enumerate(popular_books_qs):
        popular_book_cards.append({
            'obj': book,
            'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)],
        })

    return render(request, 'home.html', {
        'book_cards': book_cards,
        'categories': categories,
        'free_book_cards': free_book_cards,
        'paid_book_cards': paid_book_cards,
        'recent_book_cards': recent_book_cards,
        'popular_book_cards': popular_book_cards,
    })


