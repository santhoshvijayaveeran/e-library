# ---------- Main management entry point ----------
@login_required(login_url='home')
@user_passes_test(_is_management_user, login_url='home')
def management_view(request):
    role = _get_user_role(request.user)

    if role == 'admin':
        return render(request, 'account/management.html', {
            'role': role,
            'user_name': request.user.first_name or request.user.username,
            'user_email': request.user.email,
        })

    # ---- Author branch: gather this author's own data ----
    my_books = (
        Book.objects.filter(created_by=request.user)
        .select_related('category')
        .order_by('-created_at')
    )
    my_reviews = (
        Review.objects.filter(book__created_by=request.user)
        .select_related('user', 'book')
        .order_by('-created_at')
    )
    categories = Category.objects.all().order_by('name')

    context = {
        'role': role,
        'user_name': request.user.first_name or request.user.username,
        'user_email': request.user.email,
        'my_books': my_books,
        'my_reviews': my_reviews,
        'categories': categories,
        'book_count': my_books.count(),
        'review_count': my_reviews.count(),
    }
    return render(request, 'account/author_management.html', context)


# ---------- Author: Add book ----------
@login_required(login_url='home')
@user_passes_test(_is_author_user, login_url='home')
@require_POST
def author_add_book(request):
    title = request.POST.get('title', '').strip()
    category_id = request.POST.get('category')
    isbn = request.POST.get('isbn', '').strip()
    is_paid = request.POST.get('pricing_type') == 'Paid'
    price = request.POST.get('price') or 0
    discount = request.POST.get('discount') or 0
    cover_image = request.FILES.get('cover_image')
    pdf_file = request.FILES.get('pdf_file')

    if not title or not category_id:
        messages.error(request, 'Title and category are required.')
        return redirect('management')

    category = get_object_or_404(Category, id=category_id)

    book = Book.objects.create(
        title=title,
        category=category,
        isbn=isbn,
        is_paid=is_paid,
        price=price if is_paid else 0,
        cover_image=cover_image,
        pdf_file=pdf_file,
        created_by=request.user,      # ties book to the logged-in author
    )
    if is_paid and Decimal(str(discount)) > 0:
        Discount.objects.create(
            book=book,
            discount_type='percentage',
            value=discount,
        )
    messages.success(request, f'"{book.title}" added to the catalogue.')
    return redirect('management')


# ---------- Author: Edit own book ----------
@login_required(login_url='home')
@user_passes_test(_is_author_user, login_url='home')
@require_POST
def author_edit_book(request, book_id):
    # get_object_or_404 with created_by=request.user means an author can
    # NEVER edit another author's book, even by guessing the URL/id.
    book = get_object_or_404(Book, id=book_id, created_by=request.user)

    book.title = request.POST.get('title', book.title).strip()
    category_id = request.POST.get('category')
    if category_id:
        book.category = get_object_or_404(Category, id=category_id)
    book.isbn = request.POST.get('isbn', book.isbn).strip()

    is_paid = request.POST.get('pricing_type') == 'Paid'
    book.is_paid = is_paid
    book.price = request.POST.get('price') or 0 if is_paid else 0
    discount_val = request.POST.get('discount') or 0
    if is_paid and Decimal(str(discount_val)) > 0:
        Discount.objects.update_or_create(
            book=book,
            defaults={'discount_type': 'percentage', 'value': discount_val},
        )
    else:
        Discount.objects.filter(book=book).delete()

    if request.FILES.get('cover_image'):
        book.cover_image = request.FILES.get('cover_image')
    if request.FILES.get('pdf_file'):
        book.pdf_file = request.FILES.get('pdf_file')

    book.save()
    messages.success(request, f'"{book.title}" updated.')
    return redirect('management')


# ---------- Author: Delete own book ----------
@login_required(login_url='home')
@user_passes_test(_is_author_user, login_url='home')
@require_POST
def author_delete_book(request, book_id):
    book = get_object_or_404(Book, id=book_id, created_by=request.user)
    title = book.title
    book.delete()
    messages.success(request, f'"{title}" removed.')
    return redirect('management')


def book_detail_view(request, book_id):
    book = get_object_or_404(Book.objects.select_related('discount'), id=book_id)

    reviews = book.reviews.select_related('user').all()
    agg = reviews.aggregate(avg_rating=Avg('rating'), review_count=Count('id'))
    avg_rating = round(agg['avg_rating'] or 0, 1)
    review_count = agg['review_count']

    is_wishlisted = False
    can_review = False
    already_reviewed = False
    in_library = False          # <-- newly added

    if request.user.is_authenticated:
        is_wishlisted = Wishlist.objects.filter(user=request.user, book=book).exists()
        already_reviewed = Review.objects.filter(user=request.user, book=book).exists()

        if book.is_paid:
            can_review = Order.objects.filter(user=request.user, book=book, status='paid').exists()
        else:
            can_review = True
            in_library = MyLibrary.objects.filter(user=request.user, book=book).exists()   # <-- newly added

    related_books = (
        Book.objects.filter(category=book.category)
        .exclude(id=book.id)
        .annotate(
            avg_rating=Coalesce(Avg('reviews__rating'), Value(5.0), output_field=FloatField()),
            review_count=Count('reviews', distinct=True)
        )
        .order_by('-avg_rating', '-review_count')[:10]
        if book.category else []
    )

    context = {
        'book': book,
        'reviews': reviews,
        'avg_rating': avg_rating,
        'review_count': review_count,
        'is_wishlisted': is_wishlisted,
        'can_review': can_review,
        'already_reviewed': already_reviewed,
        'related_books': related_books,
        'in_library': in_library,
    }
    return render(request, 'book_detail.html', context)


@login_required
def toggle_wishlist(request, book_id):
    book = get_object_or_404(Book, id=book_id)
    wishlist_item, created = Wishlist.objects.get_or_create(user=request.user, book=book)
    if not created:
        wishlist_item.delete()
        wishlisted = False
    else:
        wishlisted = True
    return JsonResponse({'wishlisted': wishlisted})


@login_required
def add_review(request, book_id):
    book = get_object_or_404(Book, id=book_id)

    if book.is_paid:
        has_purchased = Order.objects.filter(user=request.user, book=book, status='paid').exists()
        if not has_purchased:
            messages.error(request, 'Please purchase this book before leaving a review.')
            return redirect('book_detail', book_id=book.id)

    if request.method == 'POST':
        rating = request.POST.get('rating')
        comment = request.POST.get('comment')
        Review.objects.update_or_create(
            book=book, user=request.user,
            defaults={'rating': rating, 'comment': comment}
        )
        messages.success(request, 'Review posted!')
    return redirect('book_detail', book_id=book.id)


@login_required
def buy_book(request, book_id):
    """For now this only renders the checkout page, it doesn't create an order."""
    book = get_object_or_404(Book, id=book_id, is_paid=True)

    session_key = f'coupon_book_{book_id}'
    coupon_data = request.session.get(session_key)

    base_amount = book.final_price
    discount_amount = Decimal('0')
    final_amount = base_amount
    applied_code = None

    if coupon_data:
        try:
            coupon = Coupon.objects.get(id=coupon_data['coupon_id'])
            valid, _ = coupon.is_valid(purchase_amount=base_amount)
            if valid:
                discount_amount = Decimal(coupon_data['discount_amount'])
                final_amount = Decimal(coupon_data['final_amount'])
                applied_code = coupon.code
            else:
                del request.session[session_key]
        except Coupon.DoesNotExist:
            del request.session[session_key]

    context = {
        'book': book,
        'base_amount': base_amount,
        'discount_amount': discount_amount,
        'final_amount': final_amount,
        'applied_code': applied_code,
        'razorpay_key_id': settings.RAZORPAY_KEY_ID,
    }
    return render(request, 'payment_checkout.html', context)


@csrf_exempt
@login_required
def payment_success(request):
    if request.method == 'POST':
        payment_id = request.POST.get('razorpay_payment_id')
        order_id = request.POST.get('razorpay_order_id')
        signature = request.POST.get('razorpay_signature')

        order = get_object_or_404(Order, razorpay_order_id=order_id)

        params_dict = {
            'razorpay_order_id': order_id,
            'razorpay_payment_id': payment_id,
            'razorpay_signature': signature
        }

        try:
            razorpay_client.utility.verify_payment_signature(params_dict)
            order.razorpay_payment_id = payment_id
            order.razorpay_signature = signature
            order.status = 'paid'
            order.save()
            messages.success(request, 'Payment successful! Book unlocked.')
        except razorpay.errors.SignatureVerificationError:
            order.status = 'failed'
            order.save()
            messages.error(request, 'Payment verification failed.')

        return redirect('book_detail', book_id=order.book.id)


@login_required
@require_POST
def apply_coupon(request, book_id):
    """AJAX - validates the coupon code and stores it in the session."""
    book = get_object_or_404(Book, id=book_id, is_paid=True)
    code = request.POST.get('code', '').strip().upper()

    if not code:
        return JsonResponse({'success': False, 'message': 'Please enter a coupon code'})

    try:
        coupon = Coupon.objects.get(code__iexact=code)
    except Coupon.DoesNotExist:
        return JsonResponse({'success': False, 'message': 'Invalid coupon code'})

    base_amount = book.final_price

    valid, msg = coupon.is_valid(purchase_amount=base_amount)
    if not valid:
        return JsonResponse({'success': False, 'message': msg})

    already_used = CouponUsage.objects.filter(coupon=coupon, user=request.user).exists()
    if already_used:
        return JsonResponse({'success': False, 'message': 'You have already used this coupon'})

    discount_amount = coupon.calculate_discount(base_amount)
    final_amount = base_amount - discount_amount

    request.session[f'coupon_book_{book_id}'] = {
        'coupon_id': coupon.id,
        'code': coupon.code,
        'discount_amount': str(discount_amount),
        'final_amount': str(final_amount),
    }

    return JsonResponse({
        'success': True,
        'message': f'Coupon applied! You got ₹{discount_amount} discount',
        'code': coupon.code,
        'base_amount': float(base_amount),
        'discount_amount': float(discount_amount),
        'final_amount': float(final_amount),
    })


@login_required
@require_POST
def remove_coupon(request, book_id):
    """For removing a coupon."""
    request.session.pop(f'coupon_book_{book_id}', None)
    book = get_object_or_404(Book, id=book_id, is_paid=True)
    return JsonResponse({
        'success': True,
        'base_amount': float(book.final_price),
    })


@login_required
@require_POST
def create_payment_order(request, book_id):
    """After the Pay button is clicked - creates the actual order + razorpay order."""
    book = get_object_or_404(Book, id=book_id, is_paid=True)
    base_amount = book.final_price

    session_key = f'coupon_book_{book_id}'
    coupon_data = request.session.get(session_key)

    coupon = None
    discount_amount = Decimal('0')
    final_amount = base_amount

    if coupon_data:
        try:
            coupon = Coupon.objects.get(id=coupon_data['coupon_id'])
            valid, _ = coupon.is_valid(purchase_amount=base_amount)
            if valid:
                discount_amount = Decimal(coupon_data['discount_amount'])
                final_amount = Decimal(coupon_data['final_amount'])
            else:
                coupon = None
        except Coupon.DoesNotExist:
            coupon = None

    amount_paise = int(final_amount * 100)

    razorpay_order = razorpay_client.order.create({
        'amount': amount_paise,
        'currency': 'INR',
        'payment_capture': 1
    })

    order = Order.objects.create(
        user=request.user,
        book=book,
        amount=final_amount,
        coupon=coupon,
        discount_amount=discount_amount,
        razorpay_order_id=razorpay_order['id'],
        status='created'
    )

    return JsonResponse({
        'razorpay_order_id': razorpay_order['id'],
        'amount_paise': amount_paise,
        'razorpay_key_id': settings.RAZORPAY_KEY_ID,
        'db_order_id': order.id,
    })


@login_required
def serve_book_pdf(request, book_id):
    book = get_object_or_404(Book, id=book_id)

    if book.price != 0:
        raise Http404("This book is not free.")

    if not book.pdf_file:
        raise Http404("PDF not available for this book.")

    return FileResponse(
        book.pdf_file.open('rb'),
        content_type='application/pdf',
        as_attachment=False,   # opens inline, won't be downloaded
        filename=book.pdf_file.name
    )


@csrf_protect
@require_POST
def ajax_login(request):
    email = request.POST.get('email', '').strip().lower()
    password = request.POST.get('password', '')

    if not email or not password:
        return JsonResponse({'success': False, 'error': 'Email and password required'}, status=400)

    matched = User.objects.filter(email__iexact=email).first()
    user = authenticate(request, username=matched.username, password=password) if matched else None

    if user is not None:
        login(request, user)
        redirect_url = reverse('management') if _is_management_user(user) else reverse('home')
        return JsonResponse({'success': True, 'redirect_url': redirect_url})
    else:
        return JsonResponse({'success': False, 'error': 'Invalid email or password'}, status=401)
    



def category_home(request):
    category_qs = Category.objects.all().order_by('name')
    categories = []
    for cat in category_qs:
        icon, css_class = CATEGORY_STYLES.get(cat.name.strip().lower(), DEFAULT_CATEGORY_STYLE)
        categories.append({
            'name': cat.name,
            'icon': icon,
            'css_class': css_class,
            'image_url': cat.image.url if cat.image else None,
        })
    return render(request, 'category/category_home.html', {'categories': categories})

def category_detail(request, slug):
    category = get_object_or_404(Category, slug=slug)
    books = Book.objects.filter(category=category)
    return render(request, 'book/category_detail.html', {'category': category, 'books': books})

@login_required
def my_library_view(request):
    """My Library page: purchased books (permanent) + free books the user has added."""
    purchased_orders = (
        Order.objects.filter(user=request.user, status='paid')
        .select_related('book', 'book__category')
        .order_by('-created_at')
    )
    purchased_books = [order.book for order in purchased_orders]

    library_entries = (
        MyLibrary.objects.filter(user=request.user)
        .select_related('book', 'book__category')
    )
    free_books = [entry.book for entry in library_entries]

    purchased_cards = []
    for i, book in enumerate(purchased_books):
        purchased_cards.append({'obj': book, 'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)]})

    free_cards = []
    for i, book in enumerate(free_books):
        free_cards.append({'obj': book, 'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)]})

    return render(request, 'my_library.html', {
        'purchased_cards': purchased_cards,
        'free_cards': free_cards,
        'purchased_count': len(purchased_cards),
        'free_count': len(free_cards),
    })


@login_required
@require_POST
def toggle_library(request, book_id):
    """Adds/removes a free book to/from My Library (AJAX).
    Paid books should not use this endpoint - they are permanent."""
    book = get_object_or_404(Book, id=book_id)

    if book.is_paid:
        return JsonResponse({
            'success': False,
            'message': 'Paid books stay permanently in My Library and cannot be removed.'
        }, status=400)

    entry = MyLibrary.objects.filter(user=request.user, book=book).first()
    if entry:
        entry.delete()
        added = False
        message = 'Removed from My Library.'
    else:
        MyLibrary.objects.create(user=request.user, book=book)
        added = True
        message = 'Added to My Library!'

    return JsonResponse({'success': True, 'added': added, 'message': message})


# Add this to your existing views.py

def contact(request):
    if request.method == 'POST':
        name = request.POST.get('name', '').strip()
        email = request.POST.get('email', '').strip()
        subject = request.POST.get('subject', '').strip()
        message = request.POST.get('message', '').strip()

        if name and email and message:
            ContactMessage.objects.create(
                name=name,
                email=email,
                subject=subject,
                message=message,
            )
            messages.success(request, "Your message has been sent! We'll get back to you soon.")
            return redirect('contact')
        else:
            messages.error(request, "Please fill in all required fields.")

    return render(request, 'company/contact.html')


