# ---------- Admin: Access Management (real Users + Groups) ----------
@login_required(login_url='home')
@user_passes_test(_is_staff_user, login_url='home')
@require_POST
def admin_grant_access(request):
    name = request.POST.get('name', '').strip()
    email = request.POST.get('email', '').strip().lower()
    role = request.POST.get('role', 'Editor')
    password = request.POST.get('password', '')

    if not name or not email or not password:
        messages.error(request, 'Please fill all required fields.')
        return redirect('management')

    if User.objects.filter(email__iexact=email).exists():
        messages.error(request, 'That email already has access.')
        return redirect('management')

    base_username = email.split('@')[0]
    username = base_username
    suffix = 1
    while User.objects.filter(username=username).exists():
        suffix += 1
        username = f"{base_username}{suffix}"

    user = User.objects.create_user(username=username, email=email, password=password)
    user.first_name = name
    user.is_staff = (role == 'Admin')   # Admin role = full staff access
    user.save()

    if role in ('Editor', 'Viewer'):
        group, _ = Group.objects.get_or_create(name=role)
        user.groups.add(group)

    messages.success(request, f'Access granted to {name}.')
    return redirect('management')


@login_required(login_url='home')
@user_passes_test(_is_staff_user, login_url='home')
@require_POST
def admin_toggle_access(request, user_id):
    target = get_object_or_404(User, id=user_id)
    if target == request.user:
        messages.error(request, "You can't suspend your own account.")
        return redirect('management')
    target.is_active = not target.is_active
    target.save()
    messages.success(request, f"Access {'activated' if target.is_active else 'suspended'} for {target.first_name or target.username}.")
    return redirect('management')


@login_required(login_url='home')
@user_passes_test(_is_staff_user, login_url='home')
@require_POST
def admin_remove_access(request, user_id):
    target = get_object_or_404(User, id=user_id)
    if target == request.user:
        messages.error(request, "You can't remove your own account.")
        return redirect('management')
    name = target.first_name or target.username
    target.delete()
    messages.success(request, f'{name} removed from the team.')
    return redirect('management')


