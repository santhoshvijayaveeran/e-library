# ---------- Role helpers (if not already added) ----------
def _is_staff_user(user):
    return user.is_authenticated and (user.is_staff or user.is_superuser)


def _is_author_user(user):
    return user.is_authenticated and user.groups.filter(name='Author').exists()


def _is_management_user(user):
    return _is_staff_user(user) or _is_author_user(user)


def _get_user_role(user):
    if _is_staff_user(user):
        return 'admin'
    elif _is_author_user(user):
        return 'author'
    return 'user'


def about(request):
    return render(request, 'about.html', {
        'total_books': Book.objects.count(),
        'total_categories': Category.objects.count(),
        'total_authors': Author.objects.count(),
    })

def signup_view(request):
    if request.method == 'POST':
        fullname = request.POST.get('fullname', '').strip()
        email = request.POST.get('email', '').strip().lower()
        password1 = request.POST.get('password1', '')
        password2 = request.POST.get('password2', '')

        signup_redirect = f"{reverse('home')}?auth=signup"

        if not fullname or not email or not password1:
            messages.error(request, "Please fill in all fields.")
            return redirect(signup_redirect)

        if password1 != password2:
            messages.error(request, "Passwords do not match.")
            return redirect(signup_redirect)

        if len(password1) < 6:
            messages.error(request, "Password must be at least 6 characters.")
            return redirect(signup_redirect)

        if User.objects.filter(email__iexact=email).exists():
            messages.error(request, "An account with this email already exists.")
            return redirect(signup_redirect)

        base_username = email.split('@')[0]
        username = base_username
        suffix = 1
        while User.objects.filter(username=username).exists():
            suffix += 1
            username = f"{base_username}{suffix}"

        user = User.objects.create_user(username=username, email=email, password=password1)
        user.first_name = fullname
        user.save()

        # Sending the welcome email here - even if it fails, the signup
        # itself shouldn't fail, so we wrap it in a try/except.
        try:
            send_welcome_email(fullname, email)
        except Exception as e:
            # Even if the email fails, the account is already created,
            # so we just log it silently and continue.
            print(f"Welcome email failed for {email}: {e}")

        messages.success(request, "Account created successfully. Please log in.")
        return redirect(f"{reverse('home')}?auth=login")

    return redirect('home')


def books_view(request):
    books = Book.objects.all()
    return render(request, 'books.html', {'books': books})

def send_welcome_email(fullname, email):
    subject = 'Welcome to Sanza Library!'
    html_content = render_to_string('emails/welcome_email.html', {'fullname': fullname})
    plain_text = f"Hi {fullname},\n\nWelcome to Sanza Library. Read More. Learn More. Grow More."

    msg = EmailMultiAlternatives(
        subject,
        plain_text,
        settings.DEFAULT_FROM_EMAIL,
        [email],
    )
    msg.attach_alternative(html_content, "text/html")
    msg.send()

def login_view(request):
    if request.method == 'POST':
        email = request.POST.get('email', '').strip().lower()
        password = request.POST.get('password', '')

        login_redirect = f"{reverse('home')}?auth=login"

        user = None
        matched = User.objects.filter(email__iexact=email).first()
        if matched:
            user = authenticate(request, username=matched.username, password=password)

        if user is not None:
            login(request, user)
            # Server decides where each account belongs based on role:
            #   admin  -> management dashboard (full access)
            #   author -> management dashboard (limited access)
            #   user   -> regular reader home page
            if _is_management_user(user):
                return redirect('management')
            return redirect('home')

        messages.error(request, "Invalid email or password.")
        return redirect(login_redirect)

    return redirect('home')


def logout_view(request):
    logout(request)
    messages.success(request, "You have been logged out.")
    return redirect('home')


# Known category -> (icon class, colour class) mapping used only for
# styling. Any category that isn't in this list still shows up with a
# sensible default icon, so adding a brand-new category from the admin
# dashboard never breaks the homepage.
CATEGORY_STYLES = {
    'fiction':      ('fa-solid fa-book-open',   'cat-fiction'),
    'non-fiction':  ('fa-solid fa-user',        'cat-nonfiction'),
    'science':      ('fa-solid fa-flask',       'cat-science'),
    'technology':   ('fa-solid fa-display',     'cat-tech'),
    'business':     ('fa-solid fa-briefcase',   'cat-business'),
    'self-help':    ('fa-solid fa-brain',       'cat-selfhelp'),
    'history':      ('fa-solid fa-landmark',    'cat-history'),
    'children':     ('fa-solid fa-face-smile',  'cat-children'),
}
DEFAULT_CATEGORY_STYLE = ('fa-solid fa-tag', 'cat-fiction')

# Cover gradient classes cycle through for books that don't have an
# uploaded cover image, so the grid still looks varied.
COVER_CLASSES = ['cover1', 'cover2', 'cover3', 'cover4', 'cover5', 'cover6']


def category_books_view(request, category_name):
    books = Book.objects.filter(category__name__iexact=category_name)
    book_type = request.GET.get('type')
    if book_type == 'free':
        books = books.filter(is_paid=False)
    elif book_type == 'paid':
        books = books.filter(is_paid=True)
    book_cards = []
    for i, book in enumerate(books):
        book_cards.append({
            'obj': book,
            'cover_class': COVER_CLASSES[i % len(COVER_CLASSES)],
        })
    icon, css_class = CATEGORY_STYLES.get(category_name.strip().lower(), DEFAULT_CATEGORY_STYLE)
    return render(request, 'category/category_books.html', {
        'book_cards': book_cards,
        'category_name': category_name,
        'icon': icon,
        'css_class': css_class,
        'book_type': book_type,
    })


