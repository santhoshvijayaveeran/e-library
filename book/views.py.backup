from django.contrib.auth.models import Group


def _team_role(user):
    """Best-effort role label for the Access Management table."""
    if user.is_superuser or user.is_staff:
        return 'Admin'
    if user.groups.filter(name='Editor').exists():
        return 'Editor'
    if user.groups.filter(name='Viewer').exists():
        return 'Viewer'
    if user.groups.filter(name='Author').exists():
        return 'Author'
    return 'User'


# ---------- management_view: admin branch context (replace the admin half) ----------
@login_required(login_url='home')
@user_passes_test(_is_management_user, login_url='home')
def management_view(request):
    role = _get_user_role(request.user)

    if role == 'author':
        my_books = Book.objects.filter(created_by=request.user).select_related('category').order_by('-created_at')
        my_reviews = Review.objects.filter(book__created_by=request.user).select_related('user', 'book').order_by('-created_at')
        return render(request, 'author_management.html', {
            'role': role,
            'user_name': request.user.first_name or request.user.username,
            'user_email': request.user.email,
            'my_books': my_books,
            'my_reviews': my_reviews,
            'categories': Category.objects.all().order_by('name'),
            'book_count': my_books.count(),
            'review_count': my_reviews.count(),
        })

    # ---- Admin branch ----
    books = Book.objects.select_related('category').order_by('-created_at')
    categories = Category.objects.annotate(book_total=Count('books')).order_by('name')
    authors = Author.objects.order_by('name')
    about = AboutPage.load()

    team_qs = User.objects.filter(
        Q(is_staff=True) | Q(groups__name__in=['Editor', 'Viewer'])
    ).distinct().order_by('first_name', 'username')
    team = [{
        'id': u.id,
        'name': u.first_name or u.username,
        'email': u.email,
        'role': _team_role(u),
        'status': 'Active' if u.is_active else 'Suspended',
    } for u in team_qs]

    return render(request, 'account/management.html', {
        'role': role,
        'user_name': request.user.first_name or request.user.username,
        'user_email': request.user.email,
        'books': books,
        'categories': categories,
        'authors': authors,
        'about': about,
        'team': team,
        'book_count': books.count(),
        'category_count': categories.count(),
        'author_count': authors.count(),
        'team_count': len(team),
    })


# ---------- Admin: Book CRUD ----------
@login_required(login_url='home')
@user_passes_test(_is_staff_user, login_url='home')
@require_POST
def admin_add_book(request):
    title = request.POST.get('title', '').strip()
    category_id = request.POST.get('category')
    author = request.POST.get('author', '').strip()
    isbn = request.POST.get('isbn', '').strip()
    is_paid = request.POST.get('pricing_type') == 'Paid'
    price = request.POST.get('price') or 0
    discount = request.POST.get('discount') or 0

    if not title or not category_id:
        messages.error(request, 'Title and category are required.')
        return redirect('management')

    category = get_object_or_404(Category, id=category_id)

    # NOTE: adjust field names below (author/isbn/discount) to match your
    # actual Book model — these mirror the fields the old admin UI collected.
    Book.objects.create(
        title=title,
        category=category,
        author=author,
        isbn=isbn,
        is_paid=is_paid,
        price=price if is_paid else 0,
        discount=discount if is_paid else 0,
        cover_image=request.FILES.get('cover_image'),
        pdf_file=request.FILES.get('pdf_file'),
        created_by=request.user,
    )
    messages.success(request, f'"{title}" added to the catalogue.')
    return redirect('management')


@login_required(login_url='home')
@user_passes_test(_is_staff_user, login_url='home')
@require_POST
def admin_edit_book(request, book_id):
    book = get_object_or_404(Book, id=book_id)

    book.title = request.POST.get('title', book.title).strip()
    category_id = request.POST.get('category')
    if category_id:
        book.category = get_object_or_404(Category, id=category_id)
    book.author = request.POST.get('author', getattr(book, 'author', '')).strip()
    book.isbn = request.POST.get('isbn', book.isbn).strip()

    is_paid = request.POST.get('pricing_type') == 'Paid'
    book.is_paid = is_paid
    book.price = request.POST.get('price') or 0 if is_paid else 0
    book.discount = request.POST.get('discount') or 0 if is_paid else 0

    if request.FILES.get('cover_image'):
        book.cover_image = request.FILES.get('cover_image')
    if request.FILES.get('pdf_file'):
        book.pdf_file = request.FILES.get('pdf_file')

    book.save()
    messages.success(request, f'"{book.title}" updated.')
    return redirect('management')


@login_required(login_url='home')
@user_passes_test(_is_staff_user, login_url='home')
@require_POST
def admin_delete_book(request, book_id):
    book = get_object_or_404(Book, id=book_id)
    title = book.title
    book.delete()
    messages.success(request, f'"{title}" removed.')
    return redirect('management')


